<div class="main-title">Nastavení pro bodové dotazy</div>
<div class="row">
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Počet dotazů:</label>
        <input type="number" step="1" class="form-control input-150" @bind="StateService.PointQueryCount" @bind:event="oninput" min="1" @onkeydown="OnEnter" disabled="@Busy"/>
    </div>
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Podíl prázdných dotazů:</label>
        <div class="input-group input-150">
            <input type="number" step="1" class="form-control" @bind="PointQueryPercentageValue" @bind:event="oninput" min="0" max="100" @onkeydown="OnEnter" disabled="@Busy"/>
            <div class="input-group-text">%</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public StateService StateService { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> HandleEnter { get; set; }

    private Task OnEnter(KeyboardEventArgs e) => HandleEnter.InvokeAsync(e);
    private double PointQueryPercentageValue {
        get => Math.Round(StateService.PointQueryPercentage * 100.0, 10);
        set => StateService.PointQueryPercentage = Math.Round(value / 100.0, 10);
    }
}