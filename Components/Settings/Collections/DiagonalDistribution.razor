<div class="main-title">Nastavení pro diagonální distribuci</div>
<div class="row">
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Počet n-tic:</label>
        <input type="number" @bind="StateService.TupleCount" @bind:event="oninput" class="form-control input-150" min="2" @onkeydown="OnEnter" disabled="@Busy"/>
    </div>
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Počet dimenzí:</label>
        <input type="number" @bind="StateService.DimensionCount" @bind:event="oninput" class="form-control input-150" min="2" @onkeydown="OnEnter" disabled="@Busy"/>
    </div>
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Odchylka od diagonály:</label>
        <div class="input-group input-150">
            <input type="number" step="1" class="form-control" @bind="BufferValue" min="0" max="100" @onkeydown="OnEnter" disabled="@Busy"/>
            <div class="input-group-text">%</div>
        </div>
    </div>
    <div class="col-auto d-flex flex-column justify-content-end mt-2">
        <label>Podíl shodných dvojic:</label>
        <div class="input-group input-150">
            <input type="number" step="1" class="form-control" @bind="PercentageValue" min="0" max="100" @onkeydown="OnEnter" disabled="@Busy"/>
            <div class="input-group-text">%</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public StateService StateService { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> HandleEnter { get; set; }

    private Task OnEnter(KeyboardEventArgs e) => HandleEnter.InvokeAsync(e);
    private double BufferValue {
        get => Math.Round(StateService.Buffer * 100.0, 10);
        set => StateService.Buffer = Math.Round(value / 100.0, 10);
    }

    private double PercentageValue {
        get => Math.Round(StateService.Percentage * 100.0, 10);
        set => StateService.Percentage = Math.Round(value / 100.0, 10);
    }
}